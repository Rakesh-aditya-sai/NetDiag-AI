{
  "name": "netdiag-ai",
  "version": "1.0.0",
  "description": "Network Troubleshooting Assistant - web app for connectivity, DNS, firewall/port, traceroute and cloud reachability diagnostics",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "pkg . --targets node18-win-x64 --output dist/NetDiagAI-win.exe"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.14.2"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  }
}
